---
source: crates/fux-export/tests/export.rs
expression: "to_lilypond(&example(\"5\"), &options)"
---
\version "2.24.0"
\language "nederlands"

\header {
  title = "Fux, Gradus ad Parnassum, Fig. 5"
  tagline = ##f
}

\paper {
  #(set-paper-size "a4")
}

\layout {
  \context {
    \Lyrics
    \override LyricHyphen.minimum-distance = #0.5
    \override VerticalAxisGroup.nonstaff-unrelatedstaff-spacing.minimum-distance = #7
  }
}

\score {
  \header { piece = "dorisch" }
  \new StaffGroup <<
    \new Staff = "staff0" \with { instrumentName = "Sopran" shortInstrumentName = "S" }
    \new Voice = "voice0" {
      \key d \dorian \time 2/2 \clef "treble"
      a'1 | a'1 | g'1 | a'1 | b'1 | c''1 | c''1 | b'1 | d''1 | cis''1 | d''1
      \bar "|."
    }
    \new Lyrics \with { alignBelowContext = "staff0" } \lyricmode {
      \override LyricText.font-size = #-1
      "5"1 "3"1 "3"1 "5"1 "3"1 "5"1 "3"1 "3"1 "6"1 "6"1 "8"1
    }
    \new Staff = "staff1" \with { instrumentName = \markup \center-column { "Alt" \small "C. f." } shortInstrumentName = "A" }
    \new Voice = "voice1" {
      \key d \dorian \time 2/2 \clef "treble"
      d'1 | f'1 | e'1 | d'1 | g'1 | f'1 | a'1 | g'1 | f'1 | e'1 | d'1
      \bar "|."
    }
  >>
  \layout { }
}
