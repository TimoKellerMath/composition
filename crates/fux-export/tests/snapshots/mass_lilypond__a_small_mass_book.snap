\version "2.24.0"
\language "nederlands"

#(set-global-staff-size 18)

\header {
  tagline = ##f
}

\paper {
  #(set-paper-size "a4")
  min-systems-per-page = #2
}

\layout {
  \context {
    \Lyrics
    \override LyricHyphen.minimum-distance = #0.5
    \override VerticalAxisGroup.nonstaff-unrelatedstaff-spacing.minimum-distance = #7
  }
}

\bookpart {
\header { title = "Missa brevis"
  subtitle = "dorisch, A T B"
  composer = "fux-kontrapunkt, Seed 1"
}
\markup \fill-line { \override #'(font-size . 4) \bold "Kyrie" }
\markup \fill-line { \center-column { \italic "Kyrie I, Christe und Kyrie II stehen je für drei Anrufungen" \italic "(Wiederholung oder Wechsel mit dem Choral nach Ortsbrauch)." } }

\score {
  \header { piece = "Kyrie I" }
  \new StaffGroup <<
    \new Staff = "staff0" \with { instrumentName = "Alt" shortInstrumentName = "A" }
    \new Voice = "voice0" {
      \key d \dorian \time 2/2 \clef "treble"
      d'1\startGroup^\markup \small "1" | f'2 g'2 | a'1~ | a'2\stopGroup g'2 | f'2 e'2~ | e'4 d'4 d'2~ | d'2 \once \set suggestAccidentals = ##t cis'2 | d'1\fermata
      \bar "||"
    }
    \new Lyrics = "text0" \lyricsto "voice0" { "Ký" -- "ri" -- "e" __ _ "e" -- "lé" -- _ _ "i" -- _ "son." }
    \new Staff = "staff1" \with { instrumentName = "Tenor" shortInstrumentName = "T" }
    \new Voice = "voice1" {
      \key d \dorian \time 2/2 \clef "treble_8"
      r1 | a1\startGroup^\markup \small "1" | c'2 d'2 | e'1~ | e'2\stopGroup d'2~ | d'4 c'4 b2 | a1~ | a1\fermata
      \bar "||"
    }
    \new Lyrics = "text1" \lyricsto "voice1" { "Ký" -- "ri" -- "e" "e" -- "lé" -- _ "i" -- "son." __ }
    \new Staff = "staff2" \with { instrumentName = "Bass" shortInstrumentName = "B" }
    \new Voice = "voice2" {
      \key d \dorian \time 2/2 \clef "bass"
      r1 | r1 | d1\startGroup^\markup \small "1" | f2 g2 | a1~ | a2\stopGroup g2 | a1 | d1\fermata
      \bar "||"
    }
    \new Lyrics = "text2" \lyricsto "voice2" { "Ký" -- "ri" -- "e" "e" -- "lé" -- "i" -- "son." }
  >>
  \layout {
    \context {
      \Voice
      \consists "Horizontal_bracket_engraver"
      \override HorizontalBracket.direction = #UP
      \override TextScript.outside-staff-priority = #1000
    }
  }
}

